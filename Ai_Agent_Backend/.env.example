# ==============================================================================
# LIZZA AI AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholder with your actual API key
# ==============================================================================

# Google Gemini API Key — Obtain from https://aistudio.google.com/
API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gemini Model Settings
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_OUTPUT_TOKENS=250

# Weather Provider REST Endpoint (Open-Meteo)
WEATHER_PROVIDER_URL=https://api.open-meteo.com
